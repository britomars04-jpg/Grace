LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Web browser (see docs/browser.md) ---
# Engine: auto (CEF on Linux/macOS, Playwright on Windows), or force
# "cef" (in-room screenshare video) or "playwright" (Chromium).
BROWSER_ENGINE=auto
# false opens a real Chromium window you can watch while the agent browses.
BROWSER_HEADLESS=false
BROWSER_WIDTH=1280
BROWSER_HEIGHT=720

# Anti-bot measures for sites that block automation (Playwright engine only).
# BROWSER_STEALTH removes the navigator.webdriver flag and other giveaways.
BROWSER_STEALTH=true
# Optional: pin a user agent, and/or launch a real installed browser
# ("chrome" or "msedge") instead of Playwright's bundled Chromium.
BROWSER_USER_AGENT=
BROWSER_CHANNEL=

# Host policy. Leave BROWSER_ALLOWED_HOSTS empty to reach any public site while
# still blocking private/loopback addresses. Set it to a comma-separated list to
# restrict the browser to specific sites.
BROWSER_ALLOWED_HOSTS=
BROWSER_BLOCKED_HOSTS=
BROWSER_BLOCK_PRIVATE=true

# Require spoken confirmation before actions like submitting, paying or deleting.
BROWSER_CONFIRM_SENSITIVE=true

# Timeouts in seconds.
BROWSER_ACTION_TIMEOUT=15
BROWSER_NAV_TIMEOUT=30
